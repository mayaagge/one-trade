{
  "name": "one-trade",
  "private": true,
  "type": "module",
  "description": "A browser game that teaches diversification. No runtime dependencies: the only package is Playwright, a development-only screenshot tool the site never loads.",
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "fixtures": ".venv/bin/python tests/make_fixtures.py",
    "serve": "python3 -m http.server 8000",
    "export": "node --env-file-if-exists=.env scripts/export_guesses.mjs",
    "shots": "node scripts/shots.mjs",
    "checks": "node scripts/dev_checks.mjs",
    "a11y": "node scripts/dev_a11y.mjs",
    "mockups": "node scripts/make_mockups.mjs"
  },
  "devDependencies": {
    "playwright": "^1.65.1"
  }
}
