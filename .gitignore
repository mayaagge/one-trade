# Python virtual environment, never committed
.venv/
__pycache__/
*.pyc

# Secrets: the Worker secret and any API keys live in environment
# variables only, never in the repo (CLAUDE.md rule 7)
.env
.dev.vars
.wrangler/

.DS_Store

# Trial downloads, never committed
data/test_*

# The live price fetch: about 4 years of closes, refetched every weekday evening
# by .github/workflows/refresh.yml. Only data/game.json, built from it, is
# committed - committing a megabyte of raw closes every evening would bloat the
# history for nothing, and the frozen data/prices.json is the reference data.
data/live_prices.json

# Development-only screenshot tool (scripts/shots.mjs, scripts/dev_checks.mjs).
# Playwright is a devDependency, never loaded by the site, and its browsers live
# in Playwright's own cache outside the repo. Only these two folders appear here:
# node_modules, and the pictures the tool writes. tests/devTooling.test.js holds
# the rest of that promise.
node_modules/
screenshots/

# scripts/export_guesses.mjs's own output: a raw pull of real (anonymous)
# player rows from Analytics Engine. Kept local rather than committed, same
# reasoning as data/live_prices.json - it's a working copy, not the record.
data/guess_exports/
